# =============================================================================
# Telecom NOC Frontend — Environment Variables
# Copy this file to .env.local for local dev, or set these in the Vercel
# dashboard under Settings ? Environment Variables for production.
# NEVER commit real .env.local values to version control.
# =============================================================================

# URL of the deployed FastAPI backend (no trailing slash).
# - Local dev: leave blank — Vite's dev-server proxy rewrites /api ? localhost:8000 automatically.
# - Vercel production: set this to your Render service URL, e.g.:
#     VITE_API_URL=https://telecom-noc-ai-backend.onrender.com
VITE_API_URL=
