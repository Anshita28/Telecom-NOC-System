# =========================================================================
# Telecom NOC AI System — Environment Variables
# Copy this file to `.env` and fill in real values BEFORE running the app.
# NEVER commit the real `.env` with credentials to version control.
# =========================================================================

# -------------------------------------------------------------------------
# Gemini API Key (optional — leave blank to use the local deterministic fallback mode
# for all AI actions)
# -------------------------------------------------------------------------
GEMINI_API_KEY=your_key_here

# -------------------------------------------------------------------------
# Demo Authentication (REQUIRED — single-account demo gate, not multi-user auth)
# Replace the placeholders below with credentials you'll use during the presentation.
# Without these set, /api/auth/login will reject every request intentionally.
# -------------------------------------------------------------------------
DEMO_USERNAME=your_demo_username_here
DEMO_PASSWORD=your_demo_password_here

# Secret used to sign JWTs. Use a long random string (e.g. `openssl rand -hex 32
# or https://generate-random.org/encryption-key-generator).
JWT_SECRET_KEY=replace_this_with_a_long_random_string_please

# How long an access token remains valid (default 8 hours covers a full demo day)
ACCESS_TOKEN_EXPIRE_HOURS=8

# -------------------------------------------------------------------------
# Deployment configuration
# -------------------------------------------------------------------------
# PORT is auto-injected by Render/Railway. Locally you can leave it default 8000.
PORT=8000

# Comma-separated list of allowed frontend origins (set AFTER you deploy the frontend to Vercel
# add the real URL here, e.g. https://noc-demo.vercel.app)
# Default localhost origins are always added automatically.
FRONTEND_URL=
